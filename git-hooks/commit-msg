#!/usr/bin/env bash
set -euo pipefail

HOOKS_DIR="$(cd "$(dirname "$0")" && pwd -P)"
if [[ ! -f "${HOOKS_DIR}/_passthrough.sh" ]]; then
  echo "[ERROR] craftsman git hooks: ${HOOKS_DIR}/_passthrough.sh is missing; run 'craftsman install --git-hooks' to repair, or bypass once with git -c core.hooksPath= commit" >&2
  exit 1
fi
# shellcheck source=git-hooks/_passthrough.sh
source "${HOOKS_DIR}/_passthrough.sh"

run_craftsman_guard "commit-msg" "$@"
chain_git_hook "commit-msg" "$@"
