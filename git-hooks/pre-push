#!/usr/bin/env bash
set -euo pipefail

HOOKS_DIR="$(cd "$(dirname "$0")" && pwd -P)"
if [[ ! -f "${HOOKS_DIR}/_passthrough.sh" ]]; then
  echo "[ERROR] craftsman git hooks: ${HOOKS_DIR}/_passthrough.sh is missing; run 'craftsman install --git-hooks' to repair, or bypass once with git -c core.hooksPath= push" >&2
  exit 1
fi
# shellcheck source=git-hooks/_passthrough.sh
source "${HOOKS_DIR}/_passthrough.sh"

STDIN_DATA="$(cat)"
printf "%s" "${STDIN_DATA:+${STDIN_DATA}$'\n'}" | run_craftsman_guard "pre-push" "$@"
printf "%s" "${STDIN_DATA:+${STDIN_DATA}$'\n'}" | chain_git_hook "pre-push" "$@"
